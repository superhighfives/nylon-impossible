{
  "$comment": "Single source of truth for Nylon's design tokens. Run `bun run tokens` after editing; it regenerates src/web/src/styles/tokens.css and the iOS Theme.swift. `bun run tokens:check` (part of `bun run lint`) fails when those are stale. A colour may add `highContrast` (light and dark) for Increase Contrast: iOS uses it, and web can map it to `prefers-contrast: more`. See 'Visual language' in plans/done/2026-10-18-cohesive-redesign.md.",
  "color": {
    "canvas": {
      "light": "#FFFFFF",
      "dark": "#111111",
      "source": "white / graydark-1",
      "usage": "App background"
    },
    "surface": {
      "light": "#F9F9F9",
      "dark": "#191919",
      "source": "gray-2",
      "usage": "Raised areas: sheets, the composer"
    },
    "fill": {
      "light": "#F0F0F0",
      "dark": "#222222",
      "highContrast": { "light": "#E3E3E3", "dark": "#2E2E2E" },
      "source": "gray-3",
      "usage": "Soft fills: chips, row hover tint"
    },
    "hairline": {
      "light": "#D9D9D9",
      "dark": "#3A3A3A",
      "highContrast": { "light": "#8D8D8D", "dark": "#6E6E6E" },
      "source": "gray-6",
      "usage": "Rules between rows and columns"
    },
    "ink": {
      "light": "#202020",
      "dark": "#EEEEEE",
      "highContrast": { "light": "#000000", "dark": "#FFFFFF" },
      "source": "gray-12",
      "usage": "Primary text"
    },
    "inkMuted": {
      "light": "#646464",
      "dark": "#B4B4B4",
      "highContrast": { "light": "#3F3F3F", "dark": "#D4D4D4" },
      "source": "gray-11",
      "usage": "Secondary text, meta line"
    },
    "inkSubtle": {
      "light": "#838383",
      "dark": "#7B7B7B",
      "highContrast": { "light": "#5C5C5C", "dark": "#A8A8A8" },
      "source": "gray-10",
      "usage": "Placeholders, disabled"
    },
    "overdue": {
      "light": "#CE2C31",
      "dark": "#FF9592",
      "highContrast": { "light": "#A11C21", "dark": "#FFB8B5" },
      "source": "red-11",
      "usage": "Overdue text (\"3 days overdue\")"
    },
    "destructive": {
      "light": "#CE2C31",
      "dark": "#FF9592",
      "highContrast": { "light": "#A11C21", "dark": "#FFB8B5" },
      "source": "red-11",
      "usage": "Destructive actions"
    },
    "destructiveFill": {
      "light": "#FEEBEC",
      "dark": "#3B1219",
      "source": "red-3",
      "usage": "Background behind destructive content"
    },
    "notice": {
      "light": "#B54700",
      "dark": "#FF9A4D",
      "source": "orange-11 (deepened)",
      "usage": "Overnight note text and icons, on noticeFill"
    },
    "noticeFill": {
      "light": "#FFF1E0",
      "dark": "#2B1A0C",
      "source": "orange-3",
      "usage": "The overnight note's pill"
    },
    "brand": {
      "light": "#FFE629",
      "dark": "#FFE629",
      "source": "yellow-9",
      "usage": "Fill only: done checkbox, send button, focus ring. Never text on white."
    },
    "brandInk": {
      "light": "#473B1F",
      "dark": "#473B1F",
      "source": "yellow-12",
      "usage": "Text and icons on a brand fill"
    }
  },
  "font": {
    "display": {
      "family": "Archivo Variable",
      "iosFamilyName": "Archivo",
      "fallback": "system",
      "usage": "Wordmark, list titles, detail title"
    },
    "text": {
      "family": "system",
      "usage": "Everything else (SF on Apple platforms)"
    }
  },
  "type": {
    "phone": {
      "display": { "font": "display", "size": 34, "lineHeight": 40, "weight": 700, "iosTextStyle": "largeTitle" },
      "title": { "font": "display", "size": 22, "lineHeight": 28, "weight": 600, "iosTextStyle": "title2" },
      "body": { "font": "text", "size": 17, "lineHeight": 22, "weight": 400, "iosTextStyle": "body" },
      "meta": { "font": "text", "size": 13, "lineHeight": 18, "weight": 400, "iosTextStyle": "footnote" }
    },
    "wide": {
      "display": { "font": "display", "size": 40, "lineHeight": 46, "weight": 700, "iosTextStyle": "largeTitle" },
      "title": { "font": "display", "size": 22, "lineHeight": 28, "weight": 600, "iosTextStyle": "title2" },
      "body": { "font": "text", "size": 15, "lineHeight": 20, "weight": 400, "iosTextStyle": "subheadline" },
      "meta": { "font": "text", "size": 13, "lineHeight": 18, "weight": 400, "iosTextStyle": "footnote" }
    }
  },
  "space": {
    "unit": 4,
    "scale": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
    "rowMinHeight": 44
  },
  "radius": {
    "chip": 6,
    "field": 10
  },
  "motion": {
    "fast": 150,
    "base": 220,
    "slow": 320,
    "easeOutStrong": [0.23, 1, 0.32, 1]
  },
  "icons": {
    "$comment": "lucide (web) → SF Symbol (iOS), so the same glyph means the same thing. Add both sides when either app needs a new icon.",
    "add": { "lucide": "Plus", "sfSymbol": "plus" },
    "done": { "lucide": "Check", "sfSymbol": "checkmark" },
    "doneCircle": { "lucide": "CheckCircle2", "sfSymbol": "checkmark.circle" },
    "close": { "lucide": "X", "sfSymbol": "xmark" },
    "remove": { "lucide": "Minus", "sfSymbol": "minus" },
    "pin": { "lucide": "Pin", "sfSymbol": "pin.fill" },
    "repeat": { "lucide": "Repeat", "sfSymbol": "repeat" },
    "due": { "lucide": "Calendar", "sfSymbol": "calendar" },
    "time": { "lucide": "Clock", "sfSymbol": "clock" },
    "notes": { "lucide": "FileText", "sfSymbol": "doc.text" },
    "link": { "lucide": "Link2", "sfSymbol": "link" },
    "externalLink": { "lucide": "ExternalLink", "sfSymbol": "arrow.up.right" },
    "email": { "lucide": "Mail", "sfSymbol": "envelope" },
    "subtasks": { "lucide": "ListTree", "sfSymbol": "list.bullet.indent" },
    "edit": { "lucide": "Pencil", "sfSymbol": "pencil" },
    "newList": { "lucide": "ListPlus", "sfSymbol": "text.badge.plus" },
    "delete": { "lucide": "Trash2", "sfSymbol": "trash" },
    "more": { "lucide": "Ellipsis", "sfSymbol": "ellipsis" },
    "settings": { "lucide": "Settings", "sfSymbol": "gear" },
    "retry": { "lucide": "RefreshCw", "sfSymbol": "arrow.clockwise" },
    "error": { "lucide": "AlertCircle", "sfSymbol": "exclamationmark.circle" },
    "info": { "lucide": "Info", "sfSymbol": "info.circle" },
    "dragHandle": { "lucide": "GripVertical", "sfSymbol": "line.3.horizontal" },
    "chevronDown": { "lucide": "ChevronDown", "sfSymbol": "chevron.down" },
    "chevronLeft": { "lucide": "ChevronLeft", "sfSymbol": "chevron.left" },
    "chevronRight": { "lucide": "ChevronRight", "sfSymbol": "chevron.right" },
    "themeSystem": { "lucide": "Monitor", "sfSymbol": "circle.lefthalf.filled" },
    "themeLight": { "lucide": "Sun", "sfSymbol": "sun.max" },
    "themeDark": { "lucide": "Moon", "sfSymbol": "moon" }
  }
}

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# AI Gateway ID
AI_GATEWAY_ID=nylon-impossible

# Cloudflare API (Optional)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_token_here

# Tavily Web Search
TAVILY_API_KEY=your_tavily_key_here

# Gmail add-on connect-flow state secret (HMAC).
# Generate with: openssl rand -base64 32
# Must be the SAME value here and in src/web/.env — the API signs the connect
# state and the web /connect/gmail-addon route verifies it.
GMAIL_ADDON_STATE_SECRET=

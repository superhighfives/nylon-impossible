# Clerk Authentication (required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Sentry (optional — absent in dev, set in production)
VITE_SENTRY_DSN=

# Sentry source map upload (CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_WEB_PROJECT=

# Gmail add-on connect-flow state secret (HMAC).
# Generate with: openssl rand -base64 32
# Must be the SAME value here and in src/api/.env — the API signs the connect
# state and the web /connect/gmail-addon route verifies it.
GMAIL_ADDON_STATE_SECRET=

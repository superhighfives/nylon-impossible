{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nylon-impossible",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/worker.ts",
	// Keep Preview URLs enabled across deploys — see src/api/wrangler.jsonc for
	// the full rationale. wrangler deploy otherwise resets them to match
	// workers_dev (off) on every deploy, breaking preview URL minting.
	"preview_urls": true,
	"routes": [
		{
			"pattern": "nylonimpossible.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nylon-impossible-db",
			"database_id": "effd712c-bc6e-4536-bddd-735b56502080",
			// Miniflare's local D1 persistence is keyed per-worker (this config's
			// top-level "name"), not just database_id — so even though this is the
			// SAME database as src/api/wrangler.jsonc, `wrangler dev`/`vite dev` here
			// reads a SEPARATE local sqlite file from the API's. migrations_dir lets
			// `wrangler d1 migrations apply -c src/web/wrangler.jsonc` populate it
			// directly instead of only the API's copy (see root db:migrate script).
			"migrations_dir": "../api/migrations"
		}
	],
	// ENVIRONMENT was never set for this worker before (unlike src/api/wrangler.jsonc,
	// which has always had it) — added so web-only user provisioning
	// (ensureUserExists in src/web/src/lib/auth.ts) can gate its demo-account
	// seeding the same way the API worker's ensureUser does. "production" is
	// passed at deploy time via --var (see .github/workflows/web-deploy.yml),
	// not set here, matching the API's pattern.
	"vars": {
		"ENVIRONMENT": "development"
	},
	"observability": {
		"enabled": true
	},
	// Worker Previews (private beta): per-branch preview deployments created by
	// `wrangler preview`. Bindings are NOT inherited from the top level, so the
	// DB binding is repeated here, pointed at the SEPARATE preview database (not
	// prod's) — the same DB the API preview binds to, kept isolated from prod
	// data. Its schema is migrated by the API's deploy-preview CI step. The API
	// base URL the web app talks to is a build-time Vite var (VITE_API_BASE_URL),
	// wired to the matching API preview URL in CI — not a wrangler binding, so it
	// does not appear here.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "nylon-impossible-preview-db",
				"database_id": "4d45eefe-fe54-4bfa-a7d4-3bc3966ea18d"
			}
		],
		"vars": {
			"ENVIRONMENT": "preview"
		},
		"observability": {
			"enabled": true
		}
	}
}
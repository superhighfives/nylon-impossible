{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "nylon-impossible",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/worker.ts",
	"routes": [
		{
			"pattern": "nylonimpossible.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "nylon-impossible-db",
			"database_id": "effd712c-bc6e-4536-bddd-735b56502080"
		}
	],
	"observability": {
		"enabled": true
	},
	// Worker Previews (private beta): per-branch preview deployments created by
	// `wrangler preview`. Bindings are NOT inherited from the top level, so the
	// DB binding is repeated here (reusing the production database_id, so previews
	// share prod D1 data). The API base URL the web app talks to is a build-time
	// Vite var (VITE_API_BASE_URL), wired to the matching API preview URL in CI —
	// it is not a wrangler binding, so it does not appear here.
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "nylon-impossible-db",
				"database_id": "effd712c-bc6e-4536-bddd-735b56502080"
			}
		],
		"observability": {
			"enabled": true
		}
	}
}